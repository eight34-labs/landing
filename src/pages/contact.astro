---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — Eight34 Labs" description="Tell Tee Jay where your week goes. Fill in the form and get a ready-to-send inquiry, or reach Tee Jay directly on LinkedIn.">
  <main>
    <section class="page-hero page-hero--ruled">
      <p class="hero-label">Contact</p>
      <h1>Contact us</h1>
      <p>Tell us where your week goes.</p>
      <p>Fill this in and we&rsquo;ll turn it into a ready-to-send inquiry you can copy — or reach Tee Jay directly on LinkedIn. No newsletter, no spam, no obligation.</p>
    </section>

    <!-- Contact intro cards -->
    <section class="section" style="padding-top: 0;">
      <div class="services-grid">
        <div class="service-card fastest-route-card">
          <span class="num">FASTEST ROUTE</span>
          <h3>Fastest route</h3>
          <p>Message Tee Jay on LinkedIn — it&rsquo;s where Eight34 Labs conversations start.</p>
          <p style="margin-top: 16px;"><a class="btn-primary" href="https://www.linkedin.com/in/teejay834/" target="_blank" rel="noreferrer">Open LinkedIn ↗</a></p>
        </div>
        <div class="service-card">
          <span class="num">WHAT HAPPENS NEXT</span>
          <h3>What happens next</h3>
          <p>We reply, set up a short conversation at your business or by phone, and if there&rsquo;s a fit, follow with a costed audit plan. If there isn&rsquo;t a fit, we&rsquo;ll say so plainly.</p>
        </div>
      </div>
    </section>

    <!-- Form -->
    <section class="section" style="border-top: 1px solid var(--ink-150);">
      <div class="section-head">
        <h2>Build your inquiry</h2>
        <p>Your inquiry, ready to send</p>
      </div>
      <div class="form-card form-panel">
        <label for="c-name">Your name</label>
        <input type="text" id="c-name" autocomplete="name" />

        <label for="c-business">Business name</label>
        <input type="text" id="c-business" autocomplete="organization" />

        <label for="c-type">Type of business</label>
        <select id="c-type">
          <option value="">Choose one…</option>
          <option>Retail / shop</option>
          <option>Restaurant / café / food</option>
          <option>Salon, clinic, or fitness</option>
          <option>Home services / contractor</option>
          <option>Professional office</option>
          <option>Other local business</option>
        </select>

        <label for="c-time">What eats most of your time right now?</label>
        <textarea id="c-time" rows="3"></textarea>

        <label for="c-reach">Best way to reach you</label>
        <input type="text" id="c-reach" />

        <div class="form-actions">
          <button type="button" class="btn-primary" id="c-build" style="padding: 10px 22px; font-size: 14px;">Build my inquiry message</button>
          <button type="button" class="btn-outline" id="c-copy" style="padding: 10px 22px; font-size: 14px;">Copy message</button>
          <a class="btn-outline" id="c-mailto" href="mailto:hello@e34labs.com" style="padding: 10px 22px; font-size: 14px;">Email hello@e34labs.com</a>
        </div>

        <label for="c-output" style="margin-top: 24px;">Your inquiry, ready to send</label>
        <textarea id="c-output" readonly rows="8" placeholder="Fill in the fields above, then choose “Build my inquiry message”."></textarea>
        <p id="c-status" class="form-status"></p>
      </div>
    </section>



    <!-- Closing CTA -->
    <section class="section" style="border-top: 1px solid var(--ink-150); padding-bottom: 90px;">
      <div class="contact-cta-box">
        <h2>Prefer to just write?</h2>
        <p>Email hello@e34labs.com, or message Tee Jay on LinkedIn.</p>
        <div class="contact-cta-actions">
          <a class="btn-primary" href="mailto:hello@e34labs.com" style="padding: 12px 24px; font-size: 14.5px;">Email hello@e34labs.com</a>
          <a class="btn-outline" href="https://www.linkedin.com/in/teejay834/" target="_blank" rel="noreferrer" style="padding: 12px 24px; font-size: 14.5px;">LinkedIn ↗</a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      var buildBtn = document.getElementById('c-build');
      var copyBtn = document.getElementById('c-copy');
      var output = document.getElementById('c-output');
      var status = document.getElementById('c-status');
      var mailto = document.getElementById('c-mailto');
      if (!buildBtn || !output) return;
      function val(id) {
        var el = document.getElementById(id);
        return el ? el.value.trim() : '';
      }
      function build() {
        var name = val('c-name');
        var business = val('c-business');
        var type = val('c-type');
        var time = val('c-time');
        var reach = val('c-reach');
        var lines = [];
        lines.push('Hi Tee Jay,');
        lines.push('');
        lines.push('I run ' + (business || '[business name]') + (type ? ' (' + type + ')' : '') + ' and I would like to talk about where AI could save us time or money.');
        if (time) lines.push('The work that eats most of our time right now is: ' + time + '.');
        if (name) lines.push('My name is ' + name + '.');
        if (reach) lines.push('The best way to reach me is: ' + reach + '.');
        lines.push('');
        lines.push('Thanks,');
        lines.push(name || '[your name]');
        var msg = lines.join('\n');
        output.value = msg;
        if (mailto) {
          mailto.href = 'mailto:hello@e34labs.com?subject=' + encodeURIComponent('AI inquiry — ' + (business || 'local business')) + '&body=' + encodeURIComponent(msg);
        }
        if (status) status.textContent = 'Your inquiry is ready — copy it, or use the email link.';
      }
      buildBtn.addEventListener('click', build);
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          if (!output.value) build();
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(output.value).then(function () {
              if (status) status.textContent = 'Copied — paste it into LinkedIn or email.';
            });
          } else {
            output.select();
            document.execCommand('copy');
            if (status) status.textContent = 'Copied — paste it into LinkedIn or email.';
          }
        });
      }
    })();
  </script>
</Layout>
